        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Securebit {\n        +main(args: String[])\n    }\n\n    class AutenticacaoService {\n        -ConexaoMySQL conexao\n        -AuditorLog auditorLog\n        +autenticar(login: Login) boolean\n        +verificarAcesso(usuario: String) boolean\n    }\n\n    class Login {\n        -String usuario\n        -String senha\n        +getUsuario() String\n        +getSenha() String\n    }\n\n    class ConexaoMySQL {\n        -String url\n        -String usuario\n        -String senha\n        +conectar()\n        +desconectar()\n    }\n\n    class Vault {\n        -List~LoginItem~ itens\n        -Criptografia cripto\n        +adicionarItem(item: LoginItem)\n        +removerItem(id: int)\n        +listarItens()\n    }\n\n    class LoginItem {\n        -int id\n        -String titulo\n        -String usuario\n        -String senhaCriptografada\n        +getSenhaCriptografada() String\n    }\n\n    class Criptografia {\n        -String chave\n        +criptografar(texto: String) String\n        +descriptografar(texto: String) String\n    }\n\n    class AuditorLog {\n        -String caminhoArquivoLog\n        +registrarAcao(acao: String)\n    }\n\n    Securebit --&gt; AutenticacaoService\n    AutenticacaoService --&gt; Login\n    AutenticacaoService --&gt; ConexaoMySQL\n    AutenticacaoService --&gt; AuditorLog\n    Login --&gt; Vault\n    Vault \&quot;1\&quot; *-- \&quot;many\&quot; LoginItem\n    Vault --&gt; Criptografia&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nFEoSDCbYponhWoFf5_x-2">
